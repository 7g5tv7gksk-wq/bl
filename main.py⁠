    server_thread = threading.Thread(target=run_flask_server, daemon=True)
    server_thread.start()
    logging.info("Flask web server thread active on port 10000.")

    # Start trading engine (Default 5-min interval = 300s)
    main_trading_loop(interval_seconds=300)
